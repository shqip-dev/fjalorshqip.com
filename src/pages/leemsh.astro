---
import Lemsh from '../components/lemsh/Lemsh';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Lëmsh | Loja e shkronjave shqipe | fjalorshqip.com"
  description="Lëmsh — rendit shkronjat e përziera dhe nxirr fjalët e ditës. Pesë a gjashtë fjalë, secila me orën e vet."
>
  {
    /* The board knows which day it is, which day was asked for and what this
       browser has already played — none of which exists at build time, so the
       page ships the frame and the island renders the game. */
  }
  <Lemsh client:only="preact" />

  <noscript>
    <p class="noscript">
      Lëmshi luhet në shfletues. Aktivizoni JavaScript-in për ta luajtur, ose
      <a href="/">kërkoni një fjalë</a> në fjalor.
    </p>
  </noscript>
</MainLayout>

<style lang="scss">
  .noscript {
    padding-top: clamp(1.75rem, 6vw, 3rem);
    line-height: var(--leading-read);
    color: var(--ink-muted);
  }
</style>
