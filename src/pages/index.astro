---
import DynamicEntries from '../components/dynamicentries/DynamicEntries';
import SearchBar from '../components/searchbar/SearchBar.tsx';
import MainLayout from '../layouts/MainLayout.astro';
import { getSiteUrl } from '../lib/env.ts';
import { SITE_DESCRIPTION, SITE_NAME, getSiteSchema } from '../lib/seo.ts';

const siteUrl = getSiteUrl(Astro.site?.href);
---

<MainLayout
  title="Fjalor Shqip | fjalorshqip.com"
  socialTitle={SITE_NAME}
  description={SITE_DESCRIPTION}
  schema={getSiteSchema(siteUrl)}
>
  <div class="lookup">
    <SearchBar client:load autoFocus />
    <DynamicEntries client:only="preact" />
  </div>
</MainLayout>

<style lang="scss">
  /* `index.astro` is also the 404 catch-all, so this spacing has to sit right
     both for the bare home page and for a word page rendered in the browser. */
  .lookup {
    padding-top: clamp(2rem, 9vh, 5rem);
  }
</style>
