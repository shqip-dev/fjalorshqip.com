---
import Entries from '../../components/entries/Entries';
import SearchBar from '../../components/searchbar/SearchBar';
import MainLayout from '../../layouts/MainLayout.astro';
import { getSlugDictionary, type Entry } from '../../lib/dictionary.ts';
import type { Neighbour } from '../../lib/entryFormat.ts';
import { shouldSkipStaticWordPages } from '../../lib/env';
import { getStemPrefix } from '../../lib/process.ts';

export async function getStaticPaths() {
  const slugDictionary = shouldSkipStaticWordPages()
    ? {}
    : await getSlugDictionary();

  const entries = Object.entries(slugDictionary);

  // Guide words span the sub-index the word lives in — the same 3-character
  // bucket the browser fetches — so a prerendered page and a page rendered in
  // the browser name the same neighbours. `EntriesLoader.getNeighbours` is the
  // client half of this rule and must keep matching it.
  const collator = new Intl.Collator('sq');
  const buckets = new Map<string, { slug: string; term: string }[]>();
  for (const [slug, value] of entries) {
    const prefix = getStemPrefix(slug);
    const bucket = buckets.get(prefix) || [];
    bucket.push({ slug, term: value[0]?.term || slug });
    buckets.set(prefix, bucket);
  }

  const neighbours = new Map<
    string,
    { prev: Neighbour | null; next: Neighbour | null }
  >();
  for (const bucket of buckets.values()) {
    bucket.sort((a, b) => collator.compare(a.term, b.term));
    bucket.forEach((entry, index) => {
      neighbours.set(entry.slug, {
        prev: bucket[index - 1] || null,
        next: bucket[index + 1] || null,
      });
    });
  }

  return entries.map(([key, value]) => ({
    params: {
      slug: key,
    },
    props: {
      entries: value as Entry[],
      ...(neighbours.get(key) || { prev: null, next: null }),
    },
  }));
}

const { entries, prev, next } = Astro.props;
const term = entries[0].term;
---

<MainLayout
  title={`${term} | Kuptimi i fjalës | fjalorshqip.com`}
  description={`Kuptimi i fjalës ${term} në gjuhën shqipe. Definicioni i ${term}.`}
>
  <div class="lookup">
    <SearchBar client:load compact />
    <Entries entries={entries} prev={prev} next={next} />
  </div>
</MainLayout>

<style lang="scss">
  .lookup {
    padding-top: clamp(1.4rem, 4vh, 2.4rem);
  }
</style>
