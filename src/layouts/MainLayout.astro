---
import FooterLinks from '../components/footerlinks/FooterLinks';
import { getSiteUrl } from '../lib/env.ts';
import {
  LOCALE,
  OG_IMAGE,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_NAME,
  getAssetUrl,
  getCanonicalUrl,
  serializeSchema,
} from '../lib/seo.ts';
import '../styles/fonts.scss';
import '@fontsource/alegreya-sc/latin-400.css';
import '@fontsource/alegreya-sc/latin-700.css';
import '../styles/global.scss';

interface Props {
  title: string;
  description: string;
  /** What a shared link is titled, when the page title is too long for a card. */
  socialTitle?: string;
  type?: 'website' | 'article';
  /** A site-absolute path to this page's own social card; defaults to the site's. */
  image?: string;
  imageAlt?: string;
  /** JSON-LD nodes; they are emitted as one `@graph`. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  socialTitle,
  type = 'website',
  image = OG_IMAGE,
  imageAlt = OG_IMAGE_ALT,
  schema,
} = Astro.props;

// `Astro.site` is the configured site; `getSiteUrl` lets SITE_URL override it,
// the way `opensearch.xml.ts` already does, so one build can be served from
// somewhere else without its own addresses pointing home.
const siteUrl = getSiteUrl(Astro.site?.href);
const canonical = getCanonicalUrl(Astro.url.pathname, siteUrl);
const imageUrl = getAssetUrl(image, siteUrl);
const cardTitle = socialTitle || title;

const metaStr = import.meta.env.META_TAGS;
const meta: [string, string][] = metaStr ? Object.entries(JSON.parse(metaStr)) : [];
---

<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e9e4d7" />
    {
        meta.map(([key, val]) => <meta name={key} content={val} />)
    }
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
    <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="search" type="application/opensearchdescription+xml" title="FjalorShqip Search" href="/opensearch.xml">
    <title>{title}</title>
    {
        schema && schema.length !== 0 && (
          <script
            id="schema-org"
            type="application/ld+json"
            is:inline
            set:html={serializeSchema(schema)}
          />
        )
    }
    <script defer src="https://cloud.umami.is/script.js" data-website-id="2a305a59-e47b-4fc7-bf6c-0af934b1860e"></script>
  </head>
  <body>
    <a id="skip-nav" class="screenreader-text" href="#main-content">
      Kalo te përmbajtja
    </a>

    <header class="head">
      <div class="head-inner container">
        <a href="/" class="wordmark sc">Fjalor Shqip</a>
        <p class="head-note">Fjalor i gjuhës shqipe</p>
      </div>
    </header>

    <main id="main-content" class="container">
      <slot />
    </main>

    <footer class="colophon">
      <div class="container">
        <FooterLinks
          links={[
            { label: 'ballina', url: '/' },
            { label: 'fjalëz', url: '/fjaleez' },
            { label: 'lëmsh', url: '/leemsh' },
            { label: 'rreth', url: '/rreth' },
            {
              label: 'kodi',
              url: 'https://github.com/shqip-dev/fjalorshqip.com',
              target: '_blank',
            },
          ]}
        />
        <p class="colophon-note">
          Faqe tërësisht statike — kërkimi ndodh në shfletuesin tuaj.
        </p>
        <p class="colophon-note">&copy; {new Date().getFullYear()} fjalorshqip.com</p>
      </div>
    </footer>
  </body>
</html>

<style lang="scss">
  .head {
    border-bottom: 2px solid var(--cloth);
  }

  .head-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    padding-block: 0.85rem 0.75rem;
  }

  .wordmark {
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--cloth);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  main {
    flex: 1 0 auto;
    padding-bottom: clamp(3rem, 10vw, 5.5rem);
  }

  .colophon {
    background-color: var(--cloth);
    color: var(--on-cloth);
    padding-block: 1.6rem 2.4rem;
    font-family: 'Alegreya SC', 'Alegreya Variable', Georgia, serif;
    font-size: var(--step-guide);
    letter-spacing: 0.06em;
  }

  .colophon-note {
    margin-top: 0.4rem;
    font-family: 'Alegreya Variable', 'Alegreya', Georgia, serif;
    font-size: var(--step-small);
    letter-spacing: normal;
  }
</style>
